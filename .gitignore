# Python
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
career-dashboard/backend/.venv/
.venv/

# Node / built frontend (rebuilt by run.py on start)
career-dashboard/frontend/node_modules/
career-dashboard/frontend/dist/
