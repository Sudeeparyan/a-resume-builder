# This repo must stay private: everything is committed, including personal
# details and the jobs database. Only secrets, installed libraries, and regenerated caches
# and build output stay out.

# Secrets
.env
.env.*
!.env.example
keys.txt

# Libraries (reinstalled from requirements / package.json)
.venv/
venv/
node_modules/

# Caches and build output (regenerated; run.py rebuilds the frontend on start)
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
career-dashboard/frontend/dist/
daily-job-search/.runtime/
*.pid

# LaTeX build artefacts
*.aux
*.log
*.out
*.fls
*.fdb_latexmk
*.synctex.gz

.DS_Store

# Other people's profiles (their documents, jobs, resumes and chats) stay on this PC
# only. Annie's workspace (career-dashboard/data/) is tracked as before.
career-dashboard/profiles/*
!career-dashboard/profiles/.gitkeep
