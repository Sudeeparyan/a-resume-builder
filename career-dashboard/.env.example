# Copy to .env (here or in the repository root) or put keys in the root keys.txt.
# All three are git-ignored and read only by the backend; a bare token on its
# own line is matched to its provider by prefix. Codex works with no key at all.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Kimi (Moonshot AI). Use the named MOONSHOT_API_KEY= form: Kimi keys start
# with "sk-", which is ambiguous with OpenAI's bare keys, so a bare Kimi token
# on its own line is NOT auto-detected. Set as environment variable or named line.
MOONSHOT_API_KEY=
